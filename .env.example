# Clerk -- also the source of the user ids stored on every row.
#
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is required at BUILD time, not just at
# runtime: as of @clerk/nextjs v6, `next build` exits 1 while prerendering the
# pages inside <ClerkProvider> if it is missing. v5 built without it. Any build
# environment needs it set, which is why CI passes a placeholder.
#
# CLERK_SECRET_KEY is runtime-only and must never be exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=xxx
CLERK_SECRET_KEY=xxx

NODE_ENV=development

# Neon. Use the *pooled* connection string from the Neon dashboard
# (the host contains "-pooler"). Server-side only -- never expose as NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
