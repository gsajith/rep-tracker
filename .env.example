# Clerk (unchanged -- the Supabase outage did not affect auth, and the user ids
# in the recovered data are still the live Clerk ids)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=xxx
CLERK_SECRET_KEY=xxx

NODE_ENV=development

# Neon. Use the *pooled* connection string from the Neon dashboard
# (the host contains "-pooler"). Server-side only -- never expose as NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
