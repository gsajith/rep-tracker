# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# db migration workspace (secrets + dumps)
.migrate/
.env*
!.env.example

# neonctl scratch file
.neon

# next-pwa build output. Regenerated by `next build`, including on Vercel, so
# the committed copies were dead weight that dirtied the tree on every build.
#
# The .map entries are inert today: workbox only emits them when webpack's
# devtool is on, which Next leaves off for the production client build. Listed
# anyway because next-pwa's own clean step deletes both by name, so turning on
# productionBrowserSourceMaps would otherwise put two new generated files back
# into the repo without anyone noticing.
#
# If `sw` is ever overridden in next.config.mjs, the first pattern stops
# matching and needs updating with it.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map

# Local design-tooling state (impeccable). config.json is five regenerable
# lines and the rest is per-session journals, so none of it is worth tracking.
.impeccable/
